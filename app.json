{
  "expo": {
    "name": "LittleSnooze",
    "slug": "little-snooze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "littlesnooze",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ordergroup.littlesnooze"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lato-Regular.ttf",
            "./assets/fonts/Lato-Italic.ttf",
            "./assets/fonts/Lato-Thin.ttf",
            "./assets/fonts/Lato-ThinItalic.ttf",
            "./assets/fonts/Lato-Light.ttf",
            "./assets/fonts/Lato-LightItalic.ttf",
            "./assets/fonts/Lato-Bold.ttf",
            "./assets/fonts/Lato-BoldItalic.ttf",
            "./assets/fonts/Lato-Black.ttf",
            "./assets/fonts/Lato-BlackItalic.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Lato",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Lato-Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/Lato-ThinItalic.ttf",
                    "weight": 100,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Lato-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Lato-LightItalic.ttf",
                    "weight": 300,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Lato-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Lato-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Lato-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Lato-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Lato-Black.ttf",
                    "weight": 900
                  },
                  {
                    "path": "./assets/fonts/Lato-BlackItalic.ttf",
                    "weight": 900,
                    "style": "italic"
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/Lato-Regular.ttf",
            "./assets/fonts/Lato-Italic.ttf",
            "./assets/fonts/Lato-Thin.ttf",
            "./assets/fonts/Lato-ThinItalic.ttf",
            "./assets/fonts/Lato-Light.ttf",
            "./assets/fonts/Lato-LightItalic.ttf",
            "./assets/fonts/Lato-Bold.ttf",
            "./assets/fonts/Lato-BoldItalic.ttf",
            "./assets/fonts/Lato-Black.ttf",
            "./assets/fonts/Lato-BlackItalic.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "android": {
            "image": "./assets/images/splash-transparent.png",
            "imageWidth": 1
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}